# Environments
.venv/
.venv_hpc/

# Cloned / built externally (recreated by `make verl` / `make mathlib`).
# No trailing slash: on CC this is a symlink into $SCRATCH (see Makefile's
# _link-repos-hpc), and a `repos/` pattern doesn't match a symlink.
repos

# Downloaded weights + HF cache (recreated by `make model` / `make dataset`)
models/

# Training outputs (large, regenerable)
# No trailing slash: these are symlinks into $SCRATCH (see the `repos` note
# above) and a `checkpoints/` pattern does not match a symlink.
checkpoints
global_step_390
outputs/
logs/
data/
data/*.parquet
data/smoke/
# Per-model-scale dataset splits (regenerated by scripts/prepare_*_dataset.py).
data_3b/
# results/*.json
results/_archive
results/eval
results/train

data_locolib
data_locolib_distilled
data_locolib_matched_gold

CLAUDE.md
datasets.md
logbook.md

# Lean / lean-interact caches
.lean_interact_cache/

# Python
__pycache__/
*.pyc

# Editor/OS
.DS_Store

# verl's raw per-step validation dumps (large, regenerable)
results/val_generations/
data_locolib_uncapped
data_locolib_distilled_beqok
data_locolib_cotgold
data_minif2f
results/distilled_vs_baseline_locolib
